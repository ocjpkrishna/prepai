# PrepAI reverse proxy (spec 2.5, 4.5, 10.1, 9.2 Agent 9).
# Placeholders are filled in by scripts/install.sh with sed:
#   __SERVER_NAME__  public host, for example prepai.in
#   __WEB_ROOT__     built Angular files (frontend/dist/frontend/browser)
#   __AUDIO_DIR__    AUDIO_DIR from the environment file (TTS cache)
# Nginx is the only public entry point. The app (8085) and actuator (9091) stay on 127.0.0.1.

limit_req_zone $binary_remote_addr zone=prepai_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=prepai_lessons:10m rate=30r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAME__;

    # Certbot answers its HTTP-01 challenge here; everything else goes to HTTPS.
    location /.well-known/acme-challenge/ {
        root __WEB_ROOT__;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __SERVER_NAME__;

    ssl_certificate     /etc/letsencrypt/live/__SERVER_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__SERVER_NAME__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    server_tokens off;
    client_max_body_size 1m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Actuator and Prometheus are never public (spec 8.4).
    location ^~ /actuator {
        return 404;
    }

    # Angular single-page app. Hashed assets are cached for a year.
    location / {
        root __WEB_ROOT__;
        try_files $uri $uri/ /index.html;

        location ~* \.(?:js|css|woff2?|svg|png|jpg|ico)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }

    # Image uploads for lessons are the only large request bodies (spec 3.1.1).
    location /api/v1/lessons/ {
        client_max_body_size 8m;
        limit_req zone=prepai_lessons burst=10 nodelay;
        proxy_pass http://127.0.0.1:8085;
        include /etc/nginx/snippets/prepai-proxy.conf;
    }

    location /api/v1/auth/ {
        limit_req zone=prepai_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8085;
        include /etc/nginx/snippets/prepai-proxy.conf;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8085;
        include /etc/nginx/snippets/prepai-proxy.conf;
    }

    location /ws/ {
        proxy_pass http://127.0.0.1:8085;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        include /etc/nginx/snippets/prepai-proxy.conf;
    }

    # Narration audio, named by SHA-256 hash, so it is cached for a long time (spec 4.5).
    location /audio/ {
        alias __AUDIO_DIR__/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
