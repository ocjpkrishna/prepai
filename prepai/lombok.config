config.stopBubbling = true

# Keep generated code out of the JaCoCo coverage numbers
lombok.addLombokGeneratedAnnotation = true

# @Data generates equals/hashCode/setters that are wrong for JPA entities and hide intent.
# Use @Getter, @Builder, @RequiredArgsConstructor, @Slf4j, or a record instead.
lombok.data.flagUsage = error
lombok.val.flagUsage = error
