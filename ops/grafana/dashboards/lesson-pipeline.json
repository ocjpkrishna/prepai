{
  "uid": "prepai-lesson-pipeline",
  "title": "PrepAI - Lesson pipeline",
  "tags": ["prepai"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Lessons generated by source", "datasource": {"type":"prometheus","uid":"prepai-prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "targets": [{"refId": "A", "datasource": {"type":"prometheus","uid":"prepai-prometheus"}, "expr": "sum by (source) (rate(prepai_lesson_generated_total[5m]))", "legendFormat": "{{source}}"}]},
    {"id": 2, "type": "timeseries", "title": "Cache hit share (RAG and Redis)", "datasource": {"type":"prometheus","uid":"prepai-prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "targets": [{"refId": "A", "datasource": {"type":"prometheus","uid":"prepai-prometheus"}, "expr": "sum(rate(prepai_lesson_generated_total{source=~\"RAG_CACHE|REDIS_CACHE\"}[15m])) / sum(rate(prepai_lesson_generated_total[15m]))", "legendFormat": "hit share"}]},
    {"id": 3, "type": "timeseries", "title": "Lesson latency p95 (target under 10 s)", "datasource": {"type":"prometheus","uid":"prepai-prometheus"}, "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "targets": [{"refId": "A", "datasource": {"type":"prometheus","uid":"prepai-prometheus"}, "expr": "histogram_quantile(0.95, sum by (le, source) (rate(prepai_lesson_latency_seconds_bucket[15m])))", "legendFormat": "{{source}}"}]},
    {"id": 4, "type": "timeseries", "title": "RAG lookups by result", "datasource": {"type":"prometheus","uid":"prepai-prometheus"}, "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "targets": [{"refId": "A", "datasource": {"type":"prometheus","uid":"prepai-prometheus"}, "expr": "sum by (result) (rate(prepai_rag_lookup_total[15m]))", "legendFormat": "{{result}}"}]}
  ]
}
